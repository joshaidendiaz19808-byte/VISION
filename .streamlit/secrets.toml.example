# Copy to .streamlit/secrets.toml (local) or paste into your host's secrets settings.
# Having an [auth] section turns on login. Without it, VISION runs open (local use).

# Google login: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web app).
# Add the redirect URI below as an authorized redirect URI.
[auth]
redirect_uri = "https://YOUR-APP-URL/oauth2callback"
cookie_secret = "LONG-RANDOM-STRING"   # python3 -c "import secrets; print(secrets.token_urlsafe(48))"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# false (default): users must paste their own Anthropic key for the AI review, so strangers
# can't spend yours. true: logged-in users may use ANTHROPIC_API_KEY set on the server.
allow_server_ai_key = false
